#!/bin/bash
# AFK control: on/off, plus enough diagnostics to know which channel would fire.
set -uo pipefail
AFK_DIR="${AFK_HOME:-$HOME/.claude/afk}"
FLAG="$AFK_DIR/enabled"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS="$(cd "$HERE/../scripts" && pwd)"

case "${1:-status}" in
  on)
    mkdir -p "$AFK_DIR" && touch "$FLAG"
    echo "AFK on. Turns killed by a transient API error will retry themselves (max ${AFK_MAX_RETRIES:-8})."
    ;;
  off)
    rm -f "$FLAG"
    echo "AFK off."
    ;;
  status)
    [ -f "$FLAG" ] && echo "AFK on" || echo "AFK off"
    ;;
  log)
    tail -n "${2:-20}" "$AFK_DIR/log" 2>/dev/null || echo "nothing logged yet"
    ;;
  reset)
    rm -f "$AFK_DIR"/state/* "$AFK_DIR"/queue/* 2>/dev/null
    echo "retry counters and queued resumes cleared"
    ;;
  doctor)
    exec python3 "$SCRIPTS/doctor.py"
    ;;
  test)
    exec python3 "$(cd "$HERE/../tests" && pwd)/test_afk.py"
    ;;
  *)
    echo "usage: afk {on|off|status|log [n]|reset|doctor|test}" >&2
    exit 1
    ;;
esac
